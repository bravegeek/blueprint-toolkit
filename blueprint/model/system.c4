specification {
  // ── Element kinds ──────────────────────────────────────────
  // Standard assessment layers. Add or remove kinds to fit your stack.
  element actor            // a human or external agent interacting with the system
  element system           // the top-level system boundary
  element service          // a running process or application
  element script           // a one-shot / batch process
  element datastore        // relational or document database, table, or view
  element bucket           // object storage (S3, GCS, Azure Blob, etc.)
  element queue            // message queue, task queue, or event stream
  element externalSystem   // third-party dependency outside the system boundary
  element infrastructure   // hosting, networking, runtime infrastructure

  // ── Code-level modeling ────────────────────────────────────
  element component        // a public/exported class or primary construct within a service
  element contract         // a typed interface (protocol, abstract base, or interface) crossing module boundaries
  element command          // an app/domain verb — a category of a reducer-dispatched action/command/event union
  element rule             // a developer-authored domain rule / policy / invariant (never inferred; AMBIGUOUS tier)
  element spec             // a specification-layer contract or design document reference

  // ── Relationship kinds ─────────────────────────────────────
  relationship calls
  relationship reads
  relationship writes
  relationship triggers
  relationship fetches
  relationship uploads
  relationship claims
  relationship defines     // a service/component defines a contract
  relationship implements  // a component implements a contract
  relationship handles     // a reducer/dispatcher handles a command category
  relationship governs     // a domain rule governs the component/contract/command that enforces it

  // ── Tags (cross-cutting concerns) ──────────────────────────
  // Add project-specific tags here.
  tag deprecated { color #DC143C }
  tag inferred  { color #FFB347 }   // confidence: inferred by LLM analysis, not directly verified
  tag provable  { color #90EE90 }   // confidence: provable from code (direct evidence: import, call site, inheritance)

  // ── Recommended metadata fields ───────────────────────────
  // Consider adding `owner`, `dataClassification`, and `auth` to elements
  // where those are meaningful for your project.
  //
  // Code-level elements (component, contract, spec) use a special metadata field:
  //   sourceLocation: <repo-relative-path>#<SymbolName>
  // This maps the model to code: e.g., 'src/api/handlers.py#RequestHandler' or
  // 'src/storage/protocols.ts#StorageBackend'. This is the join key for
  // deterministic extraction (matching on sourceLocation instead of title) and
  // enables future AST extractors to update elements in place without duplication.

  // ── Deployment Node kinds ──────────────────────────────────
  deploymentNode environment
  deploymentNode node
  deploymentNode container
}

model {
  // Replace this example with your own elements after running /assessment.
  //
  // Example:
  //
  // actor developer {
  //   title 'Developer'
  // }
  //
  // system mySystem {
  //   title 'My System'
  //
  //   service api {
  //     title 'API Service'
  //     technology 'Node, Express'
  //   }
  //
  //   datastore db {
  //     title 'PostgreSQL'
  //     technology 'PostgreSQL 15'
  //   }
  // }
  //
  // developer -> mySystem.api 'uses'
  // mySystem.api -> mySystem.db 'reads/writes'
}

deployment {
  // Deployment topology goes here after /assessment.
}
